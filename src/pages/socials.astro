---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const socials = await getCollection("socials");
---

<Layout>
  <ul>
    {
      socials.map(({ data }) => (
        <li class="mb-1">
          <a href={data.url} class="text-[#e5c07b] underline" target="_blank" rel="noopener noreferrer">{data.name}</a>
        </li>
      ))
    }
  </ul>
</Layout>
