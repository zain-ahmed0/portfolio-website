{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-10-23",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "portfolio-website",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page"
	},
	"observability": {
		"enabled": true
	},
	"workers_dev": false,
  "preview_urls": false
}